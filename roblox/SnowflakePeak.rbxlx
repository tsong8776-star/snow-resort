      <Item class="ModuleScript" referent="RBX2">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[-- Snowflake Peak 게임 설정값
-- 숫자를 바꾸면 게임 밸런스가 바뀌어요. (코인 보상, 가격, 썰매 속도 등)

local Config = {}

Config.DATA_STORE = "SnowflakePeak_v1" -- 저장소 이름 (바꾸면 모든 저장 기록이 새로 시작돼요)
Config.AUTOSAVE_SECONDS = 90

-- 산 모양
Config.DROP = 200 -- 정상 높이 (stud)
Config.END_Z = -60 -- 모든 슬로프가 끝나는 지점 (광장 앞)
Config.COURSE_WIDTH = 56
Config.COURSE_SPACING = 140
Config.RUNOUT = 80 -- 결승선 뒤 감속 구간 길이
Config.PLATFORM = 70 -- 정상 출발대 길이

-- 코인 보상
Config.GATE_COINS = 5 -- 깃발 문 하나 통과
Config.FINISH_COINS = 20 -- 완주
Config.PERFECT_BONUS = 25 -- 모든 깃발 통과
Config.BEST_BONUS = 15 -- 개인 최고 기록

-- 슬로프: 왼쪽(완만)부터 오른쪽(가파름) 순서
-- price: 해금 가격, mult: 코인 배수
Config.Courses = {
	{ id = "green", angle = 12, price = 0, mult = 1, color = Color3.fromRGB(70, 190, 110), sign = "SNOWFLAKE MEADOW" },
	{ id = "blue", angle = 17, price = 250, mult = 1.6, color = Color3.fromRGB(60, 130, 230), sign = "PINE TRAIL" },
	{ id = "red", angle = 23, price = 1200, mult = 2.5, color = Color3.fromRGB(230, 70, 80), sign = "FOX RUN" },
	{ id = "black", angle = 30, price = 5000, mult = 4, color = Color3.fromRGB(40, 44, 56), sign = "YETI DROP" },
}

-- 썰매: 순서대로 하나씩 업그레이드
-- speed: 최고 속도 (stud/s, 대략 km/h와 같아요)
Config.Sleds = {
	{ id = "wood", speed = 70, price = 0, color = Color3.fromRGB(160, 110, 65), trim = Color3.fromRGB(230, 200, 150) },
	{ id = "plastic", speed = 85, price = 300, color = Color3.fromRGB(240, 80, 95), trim = Color3.fromRGB(255, 220, 225) },
	{ id = "racer", speed = 100, price = 1500, color = Color3.fromRGB(55, 135, 240), trim = Color3.fromRGB(255, 255, 255) },
	{ id = "pro", speed = 120, price = 6000, color = Color3.fromRGB(245, 248, 255), trim = Color3.fromRGB(40, 60, 110) },
	{ id = "gold", speed = 140, price = 20000, color = Color3.fromRGB(245, 200, 60), trim = Color3.fromRGB(255, 245, 200) },
}

function Config.courseById(id)
	for _, c in ipairs(Config.Courses) do
		if c.id == id then
			return c
		end
	end
	return nil
end

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3">
        <Properties>
          <string name="Name">CourseGeometry</string>
          <ProtectedString name="Source"><![CDATA[-- 슬로프 모양 계산 (서버에서 지형을 만들 때, 깃발 위치를 정할 때 사용)
-- z가 커질수록 아래쪽(광장 방향)이에요.

local Config = require(script.Parent.Config)

local Geo = {}

function Geo.build()
	local courses = {}
	local n = #Config.Courses
	for i, c in ipairs(Config.Courses) do
		local a = math.rad(c.angle)
		local runDrop = Config.RUNOUT * math.tan(a * 0.5)
		local mainLen = (Config.DROP - runDrop) / math.tan(a)
		local x = (i - (n + 1) / 2) * Config.COURSE_SPACING
		local endZ = Config.END_Z
		local mainEndZ = endZ - Config.RUNOUT
		local startZ = mainEndZ - mainLen
		courses[i] = {
			cfg = c,
			index = i,
			x = x,
			width = Config.COURSE_WIDTH,
			startZ = startZ,
			mainEndZ = mainEndZ,
			finishZ = mainEndZ,
			endZ = endZ,
			mainLen = mainLen,
			-- 위에서 아래로: 정상 출발대 → 메인 슬로프 → 감속 구간
			pts = {
				{ z = startZ - Config.PLATFORM, y = Config.DROP },
				{ z = startZ, y = Config.DROP },
				{ z = mainEndZ, y = runDrop },
				{ z = endZ, y = 0 },
			},
		}
	end
	return courses
end

function Geo.heightAt(pts, z)
	if z <= pts[1].z then
		return pts[1].y
	end
	for k = 1, #pts - 1 do
		local p, q = pts[k], pts[k + 1]
		if z <= q.z then
			local t = (z - p.z) / (q.z - p.z)
			return p.y + (q.y - p.y) * t
		end
	end
	return 0
end

function Geo.shifted(pts, dy)
	local out = {}
	for k, p in ipairs(pts) do
		out[k] = { z = p.z, y = p.y + dy }
	end
	return out
end

return Geo
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">Strings</string>
          <ProtectedString name="Source"><![CDATA[-- 화면에 보이는 글자 (한국어 / 영어)
-- 로블록스 언어 설정이 한국어면 한국어, 아니면 영어로 보여요.

local Strings = {}

Strings.en = {
	lift_object = "%s Lift",
	lift_ride = "Ride lift",
	lift_unlock = "Unlock · %d ❄",
	start_object = "%s",
	start_ride = "Grab a sled",
	lodge = "Lodge",
	garage_open = "Open garage",
	garage_button = "🛷 Garage",
	garage_title = "Sled Garage",
	slopes_title = "Slopes",
	sleds_title = "Sleds",
	top_speed = "Top speed %d km/h",
	riding = "Riding",
	owned = "Owned",
	buy = "Buy %d ❄",
	locked = "🔒",
	slope_locked = "Unlock at the lift · %d ❄",
	slope_open = "Open · coins ×%s",
	best = "Best %s",
	no_best = "No record yet",
	close = "Close",
	need_coins = "%s: you need %d more ❄",
	unlocked = "%s is open! Enjoy the ride",
	sled_bought = "New sled: %s!",
	no_save = "Test mode: progress won't be saved.",
	hint_push = "Press W or push forward to start!",
	gates = "Gates %d/%d",
	finish_title = "FINISH!",
	finish_time = "%s",
	finish_detail = "Gates %d/%d   +%d ❄",
	perfect = "Perfect run!",
	new_best = "New best!",
	course_green = "Snowflake Meadow",
	course_blue = "Pine Trail",
	course_red = "Fox Run",
	course_black = "Yeti Drop",
	sled_wood = "Wooden Sled",
	sled_plastic = "Plastic Sled",
	sled_racer = "Racing Sled",
	sled_pro = "Pro Sled",
	sled_gold = "Golden Sled",
}

Strings.ko = {
	lift_object = "%s 리프트",
	lift_ride = "리프트 타기",
	lift_unlock = "해금 · %d ❄",
	start_object = "%s",
	start_ride = "썰매 타기",
	lodge = "산장",
	garage_open = "차고 열기",
	garage_button = "🛷 차고",
	garage_title = "썰매 차고",
	slopes_title = "슬로프",
	sleds_title = "썰매",
	top_speed = "최고 속도 %d km/h",
	riding = "타는 중",
	owned = "보유",
	buy = "%d ❄ 구매",
	locked = "🔒",
	slope_locked = "리프트에서 해금 · %d ❄",
	slope_open = "열림 · 코인 ×%s",
	best = "최고 %s",
	no_best = "아직 기록 없음",
	close = "닫기",
	need_coins = "%s까지 ❄ %d개가 더 필요해요",
	unlocked = "%s 열렸어요! 신나게 타 봐요",
	sled_bought = "새 썰매: %s!",
	no_save = "테스트 모드라서 기록이 저장되지 않아요.",
	hint_push = "W 키를 누르거나 앞으로 밀어서 출발!",
	gates = "깃발 %d/%d",
	finish_title = "완주!",
	finish_time = "%s",
	finish_detail = "깃발 %d/%d   +%d ❄",
	perfect = "깃발 전부 통과!",
	new_best = "최고 기록!",
	course_green = "눈꽃 초원",
	course_blue = "소나무 길",
	course_red = "여우 런",
	course_black = "설인 낭떠러지",
	sled_wood = "나무 썰매",
	sled_plastic = "플라스틱 썰매",
	sled_racer = "레이싱 썰매",
	sled_pro = "프로 썰매",
	sled_gold = "황금 썰매",
}

function Strings.lang(localeId)
	if type(localeId) == "string" and string.sub(string.lower(localeId), 1, 2) == "ko" then
		return "ko"
	end
	return "en"
end

function Strings.get(lang, key, ...)
	local t = Strings[lang] or Strings.en
	local s = t[key] or Strings.en[key] or key
	if select("#", ...) > 0 then
		local ok, out = pcall(string.format, s, ...)
		if ok then
			return out
		end
	end
	return s
end

function Strings.time(seconds)
	local m = math.floor(seconds / 60)
	local s = seconds - m * 60
	return string.format("%d:%04.1f", m, s)
end

return Strings
]]></ProtectedString>
